# 应用端口
PORT=3000

# PostgreSQL 连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://postgres:your_password@your_server_ip:5432/termrepo?schema=public"

# JWT signing secret for management-site sessions
AUTH_JWT_SECRET="replace-with-a-long-random-secret"
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Bootstrap admin account for the independent admin site.
# On service startup this account is created or updated as role=admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="TermRepo Admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Secret used to encrypt AI provider API keys stored from admin site.
# If omitted, AUTH_JWT_SECRET is used as fallback.
APP_SECRET_ENCRYPTION_KEY="replace-with-a-long-random-encryption-secret"

# Public endpoint shown to plugin users
PUBLIC_API_ENDPOINT="http://localhost:3000/api/v1"

# AI provider is configured in the admin site and encrypted in the database.
AI_REQUEST_TIMEOUT_MS=30000
